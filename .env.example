# ── CCSwitch 配置源 ─────────────────────────────────────
# 按本机 CC-Switch 安装路径调整；不要在 .env 提交真实密钥
CCSWITCH_SETTINGS_PATH=C:/Users/<you>/.cc-switch/settings.json
CCSWITCH_DB_PATH=C:/Users/<you>/.cc-switch/cc-switch.db
CCSWITCH_APP_TYPE=codex

# ── 模型路由 ─────────────────────────────────────────────
# Layer 1: CCSwitch 全局切换 provider → 所有工具跟随
# Layer 2: SF3 按任务指定不同模型（空值 = 用 DEFAULT_MODEL）
DEFAULT_MODEL=gpt-4o
WRITER_MODEL=
AUDITOR_MODEL=gpt-4o
TRUTH_EXTRACTOR_MODEL=
ARCHITECT_MODEL=
PLANNER_MODEL=

# ── LLM 配置 ─────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=120
HEALTH_CHECK_ON_STARTUP=true

# ── 存储 ─────────────────────────────────────────────────
BOOKS_DIR=books
